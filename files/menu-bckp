function restore(){
# Color
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
clear
# ==========================================
# Getting
clear
echo -e "\033[1;93m┌──────────────────────────────────────────┐\033[0m"
echo -e "\033[1;93m│$NC      INPUT LINK BACKUP VPS       $NC"|lolcat
echo -e "\033[1;93m└──────────────────────────────────────────┘\033[0m"
echo -e ""
read -p "input Link backup :  " -e url
echo -e ""

# Extract file ID dari link Google Drive
FILEID=$(echo "$url" | grep -oP "id=\K[^&]+" 2>/dev/null || echo "$url" | grep -oP "/d/\K[^/]+" 2>/dev/null || echo "")

if [ -n "$FILEID" ]; then
    echo "Downloading dari Google Drive (bypass virus scan)..."
    
    # Step 1: Get warning page and extract confirm token + uuid
    curl -sL -c /tmp/gd_cookies "https://drive.google.com/uc?export=download&id=$FILEID" -o /tmp/gd_page.html
    
    # Extract confirm token
    CONFIRM=$(grep -oP 'confirm=([0-9A-Za-z_-]+)' /tmp/gd_page.html | head -1 | cut -d= -f2)
    
    # Extract uuid
    UUID=$(grep -oP 'uuid" value="\K[0-9a-f-]+' /tmp/gd_page.html | head -1)
    
    if [ -n "$CONFIRM" ] || [ -n "$UUID" ]; then
        # Step 2: Download with confirm and uuid (bypass virus scan)
        echo "Bypassing virus scan..."
        curl -L -b /tmp/gd_cookies "https://drive.usercontent.google.com/download?id=$FILEID&export=download&confirm=t&uuid=$UUID" -o backup.zip
    else
        # No warning page, direct download
        echo "Downloading..."
        curl -L "https://drive.google.com/uc?export=download&id=$FILEID" -o backup.zip
    fi
    
    # Cek apakah download berhasil (bukan HTML error page)
    if file backup.zip | grep -q "HTML"; then
        echo -e "${RED}✗ Download gagal! File mungkin diblokir Google Drive.${NC}"
        echo "Coba upload manual atau cek permission Google Drive."
        rm -f backup.zip /tmp/gd_cookies /tmp/gd_page.html
        read -p "Press [ENTER] to back"
        menu-bckp
        return
    fi
else
    # Bukan Google Drive - pakai wget biasa
    wget -O backup.zip "$url"
fi

# Unzip dengan password, fallback tanpa password
unzip -P "vallstore" backup.zip 2>/dev/null || unzip backup.zip
rm -f backup.zip /tmp/gd_cookies /tmp/gd_page.html
echo "Start Restore"
cd /root/backup
cp passwd /etc/
cp group /etc/
cp shadow /etc/
cp gshadow /etc/
cp crontab /etc/
cp .ssh.db /etc/ssh/
cp .vmess.db /etc/vmess/
cp .vless.db /etc/vless/
cp .trojan.db /etc/trojan/
cp .shadowsocks.db /etc/shadowsocks/
cp -r kyt /var/lib/
cp -r xray /etc/
cp -r html /var/www/
cp -r limit /etc/kyt/
cp -r vmess /etc/
cp -r trojan /etc/
cp -r vless /etc/
cp -r shadowsocks /etc/
notif_restore
rm -rf /root/backup
rm -f backup.zip
echo ""
read -p "Selesai Restore press !! [ ENTER ] To Menu"
menu
}
